{
  "name": "@imposium-hub/react-textarea-autocomplete",
  "version": "4.9.13-8",
  "description": "Offers autocomplete over textarea in style of GitHub.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickelMedia/react-textarea-autocomplete"
  },
  "files": [
    "dist",
    "types.js",
    "style.css"
  ],
  "main": "dist/react-textarea-autocomplete.cjs.js",
  "module": "dist/react-textarea-autocomplete.es.js",
  "unpkg": "dist/react-textarea-autocomplete.umd.min.js",
  "author": "Jakub Benes <jukben@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NickelMedia/react-textarea-autocomplete/issues"
  },
  "homepage": "https://github.com/NickelMedia/react-textarea-autocomplete",
  "keywords": [
    "react-component",
    "textarea",
    "autocomplete",
    "react"
  ],
  "scripts": {
    "build": "cp src/types.js types.js && rollup -c",
    "dev": "yarn run example --open",
    "example": "webpack-dev-server --config webpack.dev.config.js",
    "example:build": "webpack --config webpack.prod.config.js",
    "prepublish": "yarn run build",
    "lint": "NODE_ENV=production eslint --ext=js --ext=jsx ./src",
    "lint:fix": "NODE_ENV=production yarn run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "flow": "flow",
    "flow:check": "flow check",
    "cypress": "yarn run example & wait-on http://localhost:8080 && cypress run --headed",
    "cypress:open": "cypress open",
    "deploy": "npx np --no-tests --any-branch",
    "release": "npm run lint && npm run build && npm run deploy"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/polyfill": "^7.12.1",
    "@babel/runtime": "^7.26.10",
    "@jukben/emoji-search": "1.1.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "ajv": "8.17.1",
    "all-contributors-cli": "^6.26.1",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "babel-preset-react-app": "^10.0.1",
    "css-loader": "^7.1.2",
    "cypress": "^13.17.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "flow-bin": "^0.248.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.11",
    "np": "^10.0.9",
    "prettier": "^3.4.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-test-renderer": "^16.14.0",
    "regenerator-runtime": "^0.14.1",
    "rollup": "^4.30.1",
    "rollup-plugin-license": "^3.5.3",
    "style-loader": "^4.0.0",
    "wait-on": "^8.0.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  },
  "peerDependencies": {
    "prop-types": "^15.0.0",
    "react": "^16.0.0 || ^17 || ^18",
    "react-dom": "^16.0.0 || ^17 || ^18"
  },
  "dependencies": {
    "custom-event": "^1.0.1",
    "textarea-caret": "3.0.2"
  },
  "overrides": {
    "tmp": "^0.2.5"
  },
  "husky": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "src/*.{js,jsx}": [
      "eslint src --fix",
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "setupFiles": [
      "<rootDir>/setupJest.js"
    ],
    "moduleNameMapper": {
      "\\.(css|scss)$": "<rootDir>/__mocks__/styleMock.js"
    },
    "testEnvironment": "jsdom",
    "transformIgnorePatterns": [
      "node_modules/(?!(cheerio)/)"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}